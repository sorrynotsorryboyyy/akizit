# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fichiers de travail locaux
dev.log
page.html

# Secrets Firebase / Stripe
.env*.local
serviceAccountKey.json

# Emulateurs Firebase
firestore-debug.log
ui-debug.log
firebase-debug.log
.firebase/

# Exception, en DERNIER : en gitignore la derniere regle qui matche gagne.
# Placee plus haut, elle serait annulee par `.env*.local` juste au-dessus.
# Sans elle, le gabarit ne part jamais sur le depot et personne ne sait
# quelles variables renseigner sur Vercel.
!.env.local.example
